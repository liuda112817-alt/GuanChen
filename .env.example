GUANCHEN_APP_ENV=development
GUANCHEN_LOG_LEVEL=INFO

GUANCHEN_DEEPSEEK_API_KEY=
GUANCHEN_DEEPSEEK_MODEL=deepseek-flash
GUANCHEN_DEEPSEEK_THINKING_MODE=disabled
GUANCHEN_DEEPSEEK_REASONING_EFFORT=low

GUANCHEN_LLM_TEMPERATURE=0.2
GUANCHEN_LLM_TIMEOUT_SECONDS=30
GUANCHEN_LLM_MAX_RETRIES=2

# Stage 11: JSON array of exact frontend origins (add the Bolt preview origin).
GUANCHEN_API_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
GUANCHEN_API_TIMEOUT_SECONDS=180
