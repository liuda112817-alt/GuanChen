  "components": {
    "schemas": {
      "BaziBirthDataPatch": {
        "properties": {
          "year": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 9999.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Year"
          },
          "month": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 12.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Month"
          },
          "day": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 31.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Day"
          },
          "hour": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 23.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Hour"
          },
          "minute": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 59.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Minute"
          },
          "gender": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Gender"
              },
              {
                "type": "null"
              }
            ]
          },
          "birth_place_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Birth Place Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "BaziBirthDataPatch",
        "description": "业务状态：出生资料信息补丁。\n特点是不包含 question。明确提供的字段会覆盖旧值，未提供的字段 (unset) 保持不变。"
      },
      "BirthProfile": {
        "properties": {
          "year": {
            "type": "integer",
            "maximum": 9999.0,
            "minimum": 1.0,
            "title": "Year",
            "description": "公历出生年份"
          },
          "month": {
            "type": "integer",
            "maximum": 12.0,
            "minimum": 1.0,
            "title": "Month",
            "description": "公历出生月份"
          },
          "day": {
            "type": "integer",
            "maximum": 31.0,
            "minimum": 1.0,
            "title": "Day",
            "description": "公历出生日期"
          },
          "hour": {
            "type": "integer",
            "maximum": 23.0,
            "minimum": 0.0,
            "title": "Hour",
            "description": "当地民用时小时，0-23"
          },
          "minute": {
            "type": "integer",
            "maximum": 59.0,
            "minimum": 0.0,
            "title": "Minute",
            "description": "分钟，0-59"
          },
          "gender": {
            "$ref": "#/components/schemas/Gender",
            "description": "用于确定大运顺逆的性别参数"
          },
          "birth_place_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Birth Place Text",
            "description": "可选出生地原始文本，v2.0 不参与排盘"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "year",
          "month",
          "day",
          "hour",
          "minute",
          "gender"
        ],
        "title": "BirthProfile",
        "description": "出生输入事实契约，仅记录客观输入，不包含计算过程参数"
      },
      "ChatRequest": {
        "properties": {
          "session_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 12000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "message": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 1,
            "title": "Message",
            "description": "用户输入的请求文本"
          },
          "new_task": {
            "type": "boolean",
            "title": "New Task",
            "default": false
          },
          "birth_profile": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BaziBirthDataPatch"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "session_id": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 1,
            "title": "Session Id"
          },
          "status": {
            "$ref": "#/components/schemas/ChatStatus"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "used_intents": {
            "items": {
              "$ref": "#/components/schemas/IntentType"
            },
            "type": "array",
            "title": "Used Intents",
            "default": []
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/CitationResponse"
            },
            "type": "array",
            "title": "Citations",
            "default": []
          },
          "required_input": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/InputRequirement"
              },
              {
                "type": "null"
              }
            ]
          },
          "interrupt": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/InterruptResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "safety": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SafetyDecision"
              },
              {
                "type": "null"
              }
            ]
          },
          "session_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Token"
          },
          "trace_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trace Id"
          },
          "facts": {
            "additionalProperties": true,
            "type": "object",
            "title": "Facts"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "session_id",
          "status",
          "content"
        ],
        "title": "ChatResponse"
      },
      "ChatStatus": {
        "type": "string",
        "enum": [
          "answered",
          "needs_input",
          "interrupted",
          "cancelled",
          "blocked",
          "error"
        ],
        "title": "ChatStatus"
      },
      "CitationDetailResponse": {
        "properties": {
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id"
          },
          "document_id": {
            "type": "string",
            "title": "Document Id"
          },
          "source_title": {
            "type": "string",
            "title": "Source Title"
          },
          "section": {
            "type": "string",
            "title": "Section"
          },
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "chunk_id",
          "document_id",
          "source_title",
          "section",
          "text"
        ],
        "title": "CitationDetailResponse"
      },
      "CitationResponse": {
        "properties": {
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id"
          },
          "document_id": {
            "type": "string",
            "title": "Document Id"
          },
          "source_title": {
            "type": "string",
            "title": "Source Title"
          },
          "section": {
            "type": "string",
            "title": "Section"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "chunk_id",
          "document_id",
          "source_title",
          "section"
        ],
        "title": "CitationResponse"
      },
      "Gender": {
        "type": "string",
        "enum": [
          "male",
          "female"
        ],
        "title": "Gender"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InputRequirement": {
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/RequiredDataType"
          },
          "fields": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Fields",
            "default": []
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind"
        ],
        "title": "InputRequirement"
      },
      "IntentType": {
        "type": "string",
        "enum": [
          "bazi",
          "dream",
          "liuyao",
          "knowledge",
          "chitchat",
          "out_of_scope"
        ],
        "title": "IntentType"
      },
      "InterruptResponse": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type"
          },
          "thread_id": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 1,
            "title": "Thread Id"
          },
          "prompt": {
            "type": "string",
            "title": "Prompt"
          },
          "confirmation_id": {
            "type": "string",
            "title": "Confirmation Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "thread_id",
          "prompt"
        ],
        "title": "InterruptResponse"
      },
      "ProfileResponse": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "birth_profile": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BirthProfile"
              },
              {
                "type": "null"
              }
            ]
          },
          "supplied_fields": {
            "additionalProperties": true,
            "type": "object",
            "title": "Supplied Fields"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "session_id",
          "birth_profile"
        ],
        "title": "ProfileResponse"
      },
      "ProfileUpdateRequest": {
        "properties": {
          "session_id": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 1,
            "title": "Session Id"
          },
          "birth_profile": {
            "$ref": "#/components/schemas/BaziBirthDataPatch"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "session_id",
          "birth_profile"
        ],
        "title": "ProfileUpdateRequest"
      },
      "RequiredDataType": {
        "type": "string",
        "enum": [
          "birth_profile",
          "dream_content",
          "decision_question"
        ],
        "title": "RequiredDataType"
      },
      "ResumeAction": {
        "type": "string",
        "enum": [
          "confirm",
          "cancel",
          "modify"
        ],
        "title": "ResumeAction"
      },
      "ResumeRequest": {
        "properties": {
          "session_id": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 1,
            "title": "Session Id"
          },
          "thread_id": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 1,
            "title": "Thread Id"
          },
          "action": {
            "$ref": "#/components/schemas/ResumeAction"
          },
          "confirmation_id": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 1,
            "title": "Confirmation Id"
          },
          "modification": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 12000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Modification"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "session_id",
          "thread_id",
          "action",
          "confirmation_id"
        ],
        "title": "ResumeRequest"
      },
      "RiskDomain": {
        "type": "string",
        "enum": [
          "none",
          "self_harm",
          "medical",
          "legal",
          "investment"
        ],
        "title": "RiskDomain"
      },
      "RiskLevel": {
        "type": "string",
        "enum": [
          "safe",
          "sensitive",
          "high_risk",
          "crisis"
        ],
        "title": "RiskLevel"
      },
      "SafetyAction": {
        "type": "string",
        "enum": [
